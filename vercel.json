{
  "version": 2,
  "builds": [
    {
      "src": "romanos.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*", 
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/romanos.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}